#!/usr/bin/python3
import sys, os
home = os.getenv('HOME')
sys.path.append(home + '/.local/lib')
import nix_config.nix_config as config
import nix_config.nix_interact
from nix_config.openprocess import openprocess
from nix_config.openprocess import Spinner
from sys import argv

package = config.read_packages()

if len(argv) > 1 and argv[1] == 'list':
    operation = argv[1]
elif len(argv) > 1 and argv[1] == 'clean':
    operation = argv[1]
elif len(argv) > 1 and argv[1] == 'update':
    operation = argv[1]
elif len(argv) > 2:
    operation = argv[1]
    pkg = argv[2]
else:
    print('argument missing')
    exit(1)

if operation == 'list':
    for pkg in package:
        pkg=pkg.split('.')
        pkg='.'.join(pkg[1:])
        print(pkg)
elif operation == 'install':
    with Spinner(f"Installing {pkg}"):
        added, [stdout, simple_errors, full_errors] = config.add_packages( [f'pkgs.{pkg}'] )
    if simple_errors:
        print()
        for err in full_errors:
            print(err)
    else:
        with Spinner(f"Installing {pkg}...", "done!\n"):
            openprocess('home-manager switch')

elif operation == 'remove':
    with Spinner(f"Removing {pkg}"):
        removed, [stdout, simple_errors, full_errors] = config.delete_packages( [f'pkgs.{pkg}'] )
    if simple_errors:
        print()
        for err in full_errors:
            print(err)
    else:
        with Spinner(f"Removing {pkg}...", "done!\n"):
            openprocess('home-manager switch')
        with Spinner(f"Cleaning up", "done!\n"):
            openprocess('nix-collect-garbage')
elif operation == 'clean':
    with Spinner(f'Cleaning up', 'done!\n'):
        openprocess('nix-collect-garbage')
elif operation == 'update':
    with Spinner(f'Updating', 'done!\n'):
        openprocess('nix-channel --update')
        openprocess('home-manager switch')
