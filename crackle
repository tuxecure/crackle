#!/usr/bin/env bash
# input
operation=${1};
PKG=("${@:2}");
# Configuration for Apt
APTCACHE=${APTCACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/apt};
APTSTATE=${APTSTATE:-${XDG_STATE_HOME:-$HOME/.local/state}/apt};
DPKGSTATE=${DPKGSTATE:-${XDG_STATE_HOME:-$HOME/.local/state}/dpkg};
APTCONFIG=${APTCONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/crackle};

# Configuration for Crackle
PKG_PATH=${PKG_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/crackle};
PKGS_DIR=${PKGS_DIR:-$PKG_PATH/$PKG};
CRACKLECMP=${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions;
CRACKDIR=${CRACKDIR:-$HOME/packages/$PKG};
CRACKLEBIN="https://gitlab.com/tuxecure/crackle-apt/cracklebin/-/archive/master/cracklebin-master.tar.gz"
PKG_PREFIX=${PKG_PREFIX:-$HOME/.local}
SCRP_DIR=$(dirname "${BASH_SOURCE[0]}")

# Configuration for Sudo -i
SUDO_CONFIG=/root/.config
SUDO_BIN=/root/.local/bin
SUDO_STATE=/root/.local/state

# Set up aliases for apt commands
APTCONF="-o Dir::Etc=$APTCONFIG";
APT_GET="apt-get -o Dir::Cache=$APTCACHE -o Dir::State=$APTSTATE $APTCONF"
APT_CACHE="apt-cache -o Dir::Cache=$APTCACHE -o Dir::State=$APTSTATE -o Dir::Etc=$APTCONFIG"

# click config
if [[ -z "$ROOT" ]]; then
ROOT=${ROOT:-$(pwd)}
ARCH=${ARCH:-$(dpkg --print-architecture)}
ARCH_TRIPLET=${ARCH_TRIPLET:-$(arch_triplet)}
BUILD_DIR=${BUILD_DIR:-${ROOT}/build}
INSTALL_DIR=${INSTALL_DIR:-${ROOT}/install}
CLICK_LD_LIBRARY_PATH=${CLICK_LD_LIBRARY_PATH:-${INSTALL_DIR}/lib/${ARCH_TRIPLET}}
CLICK_PATH=${CLICK_PATH:-${CLICK_LD_LIBRARY_PATH}/bin}
fi

# check if the files differ, if yes overwrite the old version
function upd() {
    lib=$(basename $1)
    if [[ ! -f "$2/$lib" && -d "$2" ]]; then
	if [[ $(basename $(dirname $1)) = "completions" ]] ; then
		say "Setting up bash_completions..." >&2
	else
		say "Installing $lib..." >&2
	fi
	cp $1 $2
    elif ! diff -q $1 $2; then
	if [[ $(basename $(dirname $1)) = "completions" ]] ; then
		say "Updating bash_completions..." >&2
	else
		say "Updating $lib..." >&2
	fi
	cp $1 $2
    fi
}

# load libraries
function load_library(){
    if [[ -f "$PKG_PREFIX/lib/$1" ]]; then
        [[ $(basename $SCRP_DIR) != "bin" ]] && upd $SCRP_DIR/lib/$1 $PKG_PREFIX/lib
        source "$PKG_PREFIX/lib/$1";
    else
        source "$SCRP_DIR/lib/$1";
    fi
}

# say something
say() {
    printf '%s\n' "$1"
}

# error out
err() {
    say "Crackle: $1" >&2
    exit 100
}

# say something and quit the script
stat() {
    say "$1" >&2
    exit 0
}

# Run a command that should never fail. If the command fails execution
# will immediately terminate with an error showing the failing
# command.
ensure() {
    if ! "$@"; then exit 1; fi
}

# set up files and directories for the functioning of apt on a ro rootfs
function pkgsetup(){
    [[ -d "$DPKGSTATE" ]] || {
        mkdir -p "$DPKGSTATE";
        cp /var/lib/dpkg/status $DPKGSTATE/status;
    }

    [[ -d "$APTCACHE" ]] || mkdir -p "$APTCACHE";
    [[ -d "$APTSTATE" ]] || mkdir -p "$APTSTATE";

    [[ -d "$APTCONFIG" ]] || {
        mkdir -p $APTCONFIG/sources.list.d $APTCONFIG/preferences.d $APTCONFIG/trusted.gpg.d;
        ln -s /etc/apt/sources.list $APTCONFIG;
        [[ -n "$(ls /etc/apt/trusted.gpg.d)" ]] && ln -s /etc/apt/trusted.gpg.d/* $APTCONFIG/trusted.gpg.d/;
    }
}

function urldecode() { : "${*//+/ }"; echo -e "${_//%/\\x}"; }

# get info of the deb package
function get_pkg_info () {
    pkg="$(basename "$1")";
    pkgname="${pkg%%_*}";
    pkgversion="${pkg%_*}";
    pkgversion="${pkgversion#*_}";
    pkgversion="$(urldecode $pkgversion)";
}

# link files from ~/.local/share/crackle into ~/.local
function link_path(){
    pkg_path="$1";
    xdg_lib_path="$2"
    while read file_path
    do
        ln -s $file_path $xdg_lib_path;
    done < <(find $pkg_path -type f -maxdepth 1)
}

# link binaries from $PKGS_DIR to $PKG_PREFIX
function bin_install () {
    PKGS_DIR=${PKG_PATH}/${pkgname}
    mkdir -p ${PKGS_DIR} $PKG_PREFIX/bin;
    dpkg-deb -x "${package}" "${PKGS_DIR}";
    [ -d "$PKGS_DIR/usr/bin" ] && link_path $PKGS_DIR/usr/bin $PKG_PREFIX/bin;
}

# set up curl and xz using apt
function setup_curlxz () {
    $APT_GET update
    $APT_GET install --download-only curl xz-utils;
    while read package
    do
        get_pkg_info $package;
        bin_install;
    done < <(ls "$APTCACHE"/archives/*.deb);
}

# check if a command is available
check_cmd() {
    command -v "$1" > /dev/null 2>&1
}

# check if a path exists
check_path() {
    if ! check_cmd curl; then export PATH=$HOME/.local/bin:$PATH; fi
}

# set up nix home manager
function setup_home-manager (){
    [ ! -d /nix ] && err "please test this on the latest focal development update"
    sh <(curl --proto '=https' --tlsv1.2 -L https://nixos.org/nix/install) --no-daemon
    . /home/phablet/.nix-profile/etc/profile.d/nix.sh
    nix-channel --add https://github.com/nix-community/home-manager/archive/master.tar.gz home-manager
    nix-channel --update
    nix-shell '<home-manager>' -A install
}

# now that we've used curl and xz there is no need to keep them around, nuke them
function pkgunset(){
    if [ -d $PKG_PATH ]; then rm -r $PKG_PATH; fi
    if [ -d $APTCACHE ]; then rm -r $APTCACHE; fi
    if [ -d $APTCONFIG ]; then rm -r $APTCONFIG; fi
    if [ -d $APTSTATE ]; then rm -r $APTSTATE; fi
    if [ -d $DPKGSTATE ]; then rm -r $DPKGSTATE; fi
    find "$PKG_PREFIX/bin" -xtype l -exec rm {} +;
}

# set up nix home-manager, leave no trace of apt config
function setup() {
    pkgsetup;
    setup_curlxz;
    check_path;
    setup_home-manager;
    pkgunset;
}

# reclaim storage space
function clean() {
    nix-collect-garbage;
    pkgunset;
}

# update packages
function update() {
    nix-channel --update;
    home-manager switch;
}

# run command as sudo and show what command will be run
sudo_run() {
    say "this action requires sudo access"
	set -x
	sudo $1
	set +x
}

# enable use of a binary with sudo -i $BIN
function enable_sudo(){
    for pkg in "${PKG[@]}"
    do
	    bin_path=$(which $pkg)
	    real_path=$(realpath $bin_path)
	    sudo_run "ln -s $real_path $SUDO_BIN/$pkg"
    done;
    exit 0;
}

# disable use of a binary with sudo -i $BIN
function disable_sudo(){
    for pkg in "${PKG[@]}"
    do
            say "this action requires sudo access"
	    set -x
	    bin_path=$(sudo -i which $pkg)
	    set +x
	    [[ -f $bin_path ]] && sudo_run "rm $bin_path";
    done;
    exit 0;
}

# View information about Crackle, don't do anything
function debug(){
    echo "CRACKLE CONFIG"
	echo "PKG_PATH: '$PKG_PATH'"
	echo "PKG_PREFIX: '$PKG_PREFIX'"
	echo "PKGS_DIR: '$PKGS_DIR'"
	echo "CRACKLECMP: '$CRACKLECMP'"
	echo "CRACKDIR: '$CRACKDIR'"
	echo "APT CONFIG"
	echo "APTCONFIG: '$APTCONFIG'"
	echo "APTCACHE: '$APTCONFIG'"
	echo "APTSTATE: '$APTSTATE'"
	echo "APT_GET: '$APT_GET'"
	echo "APT_CACHE: '$APT_CACHE'"
	echo "CLICK CONFIG"
	echo "ROOT: '$ROOT'"
	echo "ARCH: '$ARCH'"
	echo "ARCH_TRIPLET: '$ARCH_TRIPLET'"
	echo "BUILD_DIR: '$BUILD_DIR'"
	echo "INSTALL_DIR: '$INSTALL_DIR'"
	echo "CLICK_LD_LIBRARY_PATH: '$CLICK_LD_LIBRARY_PATH'"
	echo "CLICK_PATH: '$CLICK_PATH'"
}

# Help
function show_help(){
	echo 'available commands:
	- crackle setup
	- crackle debug
	- crackle sudo $BIN
	- crackle sudok $BIN
	- crackle click $PKG
	- crackle clean
	- crackle update'
	exit 0
}

case $operation in
	"sudo")[ -z "$PKG" ] && err "missing argument";enable_sudo;;
	"sudok")[ -z "$PKG" ] && err "missing argument";disable_sudo;;
    "setup") setup;;
    "clean") clean;;
    "update") update;;
    "debug") debug;;
	"click")[ -z "$PKG" ] && err "missing argument";load_library clickfunc;build_click;;
	"help")show_help;;
	*) show_help;;
esac
